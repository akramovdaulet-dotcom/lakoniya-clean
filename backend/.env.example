# Copy these variables into the hosting provider's secret/environment settings.
# Never commit the real bot token or a real .env file.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
# Comma-separated numeric Telegram user IDs allowed to manage requests.
# Keep the real ID in hosting settings, not in this public repository.
OWNER_TELEGRAM_IDS=replace_with_owner_id
# Exact HTTPS origins allowed to call the API.
ALLOWED_ORIGINS=https://lakoniya-miniapp-test.pages.dev
# Optional database file path; use persistent storage on the host.
DATABASE_PATH=./data/lakoniya.sqlite3

# Optional managed PostgreSQL URL; takes precedence over DATABASE_PATH.
# Keep the real connection URL in hosting secrets, never commit it.
DATABASE_URL=
# Bot token of the CUSTOMER Mini App (the bot customers open the form from).
# TELEGRAM_BOT_TOKEN above is the OWNER bot; do not put the same token in both.
# Paste the value without quotes or spaces.
CUSTOMER_BOT_TOKEN=replace_with_customer_bot_token
# New requests are sent to every OWNER_TELEGRAM_IDS user through the owner bot.
# Each owner must press Start in the owner bot first. Set to false to disable.
NOTIFY_OWNERS=true
# Customers get status messages in the CUSTOMER bot: "Заявка принята" on creation,
# "В обработке" / "Передана сотруднику" when an owner sets that status.
# Telegram only delivers them if the customer has started the customer bot.
# Set to false to disable.
NOTIFY_CUSTOMERS=true
# Synthetic test endpoint remains disabled unless explicitly enabled temporarily.
ENABLE_SYNTHETIC_TEST_REQUESTS=false
