# Copy these variables into the hosting provider's secret/environment settings.
# Never commit the real bot token or a real .env file.
TELEGRAM_BOT_TOKEN=replace_with_bot_token
# Comma-separated numeric Telegram user IDs allowed to manage requests.
# Keep the real ID in hosting settings, not in this public repository.
OWNER_TELEGRAM_IDS=replace_with_owner_id
# Exact HTTPS origins allowed to call the API.
ALLOWED_ORIGINS=https://lakoniya-miniapp-test.pages.dev
# Optional database file path; use persistent storage on the host.
DATABASE_PATH=./data/lakoniya.sqlite3
